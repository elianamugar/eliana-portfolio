---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Eliana Mugar">
  <main class="home">
    <div class="hero">
      <h1>ELIANA MUGAR</h1>

      <p class="subtitle">
        Creative work, research, and digital archives.
      </p>

      <div class="portal-grid">
        <a href="/creative" class="portal-card">
          <h2>Creative Portfolio</h2>
          <p>
            Photography, film, posters, and visual archives.
          </p>
        </a>

        <a href="/projects" class="portal-card">
          <h2>Research & Projects</h2>
          <p>
            Code, experiments, research, and technical work.
          </p>
        </a>

        <a href="/cv" class="portal-card">
          <h2>CV / About</h2>
          <p>
            Resume, background, contact, and experience.
          </p>
        </a>
      </div>

      <section class="connect-section">
        <p class="connect-label">Connect with me</p>

      <div class="social-links">
        <a href="mailto:elianamugar7@gmail.com" aria-label="Email" data-tooltip="Email">
          @
        </a>

        <a href="https://www.instagram.com/elianamugar" aria-label="Instagram" data-tooltip="Instagram">
          IG
        </a>

        <a href="https://letterboxd.com/elianamugar" aria-label="Letterboxd" data-tooltip="Letterboxd">
          LB
        </a>

        <a href="https://www.goodreads.com/user/show/66067615-emuggins" aria-label="Goodreads" data-tooltip="Goodreads">
          GR
        </a>

        <a href="https://github.com/elianamugar" aria-label="GitHub" data-tooltip="GitHub">
          GH
        </a>

        <a href="https://www.youtube.com/@elianamugar" aria-label="YouTube" data-tooltip="YouTube">
          YT
        </a>

        <a href="https://www.imdb.com/name/nm14175264/" aria-label="IMDb" data-tooltip="IMDb">
          IMDb
        </a>

        <a href="https://linkedin.com/in/elianamugar/" aria-label="LinkedIn" data-tooltip="LinkedIn">
          in
        </a>

      </div>
      </section>

    </div>
  </main>
</BaseLayout>