---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  FaInstagram,
  FaGithub,
  FaLinkedinIn,
  FaYoutube,
  FaImdb,
  FaGoodreadsG,
} from "react-icons/fa";

import { MdEmail } from "react-icons/md";
import { SiLetterboxd } from "react-icons/si";

import mediaFeed from "../data/mediaFeed.json";
---

<BaseLayout title="Eliana Mugar">
  <main class="home">
    <section class="home-hero">
  <p class="intro-code">
    <span id="intro-text"></span><span class="cursor">_</span>
  </p>

  <h1 class="hero-name">
    Eliana Mugar
  </h1>

  <div class="hero-code-line">
  <span class="prompt">&gt;</span>

  <p class="hero-subtitle">
    (&#123;philo&#125; ∪ &#123;poly&#125;) -math
  </p>
</div>

  <p class="hero-quote">
    <span id="quote-text"></span>
    <span class="cursor">_</span>
  </p>
</section>

<script>
  const introElement =
    document.getElementById("intro-text");

  const introText =
    "hello world, i'm:";

  let introIndex = 0;

  function typeIntro() {
    if (!introElement) return;

    if (introIndex < introText.length) {
      introElement.textContent +=
        introText.charAt(introIndex);

      introIndex++;

      setTimeout(typeIntro, 70);
    }
  }

  typeIntro();

  const quotes = [
    "Omnia vincit amor et nos cedamus amori.",
    "Semper disco.",
    "Il faut cultiver notre jardin.",
    "Wissen ist nicht genug; wir müssen es anwenden.",
    "Phantasie ist wichtiger als Wissen, denn Wissen ist begrenzt.",
    "Chi va piano va sano e va lontano.",
    "Άνθρωπος αγράμματος, ξύλο απελέκητο.",
    "Ученье — свет, а неученье — тьма.",
    "Ang kapaitan ng pag-aaral ay mas kanais-nais kaysa kapaitan ng kamangmangan.",
    "El saber no ocupa lugar.",
    "学海无涯.",
    "Al draagt een aap een gouden ring, het is en blijft een lelijk ding.",
    "Education is not preparation for life. Education is life itself."
  ];

  const quoteElement =
    document.getElementById("quote-text");

  let quoteIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function typeQuotes() {
    if (!quoteElement) return;

    const currentQuote =
      quotes[quoteIndex];

    if (!deleting) {
      quoteElement.textContent =
        currentQuote.slice(0, charIndex);

      charIndex++;

      if (charIndex > currentQuote.length) {
        deleting = true;

        setTimeout(typeQuotes, 2200);

        return;
      }
    } else {
      quoteElement.textContent =
        currentQuote.slice(0, charIndex);

      charIndex--;

      if (charIndex < 0) {
        deleting = false;

        quoteIndex =
          (quoteIndex + 1) % quotes.length;

        charIndex = 0;
      }
    }

    setTimeout(
      typeQuotes,
      deleting ? 22 : 40
    );
  }

  setTimeout(typeQuotes, 1800);
</script>

      <div class="portal-grid">
        <a href="/creative" class="portal-card">
          <h2>Creative Portfolio</h2>
        </a>

        <a href="/cv" class="portal-card">
          <h2>CV / About</h2>
        </a>

        <a href="/projects" class="portal-card">
          <h2>Research & Projects</h2>
        </a>
      </div>

      <section class="connect-section">
        <p class="connect-label">Connect with me</p>

      <div class="social-links">
        <a href="mailto:elianamugar7@gmail.com" aria-label="Email"
        data-tooltip="Email">
          <MdEmail />
        </a>

        <a
          href="https://instagram.com/elianamugar"
          target="_blank"
          aria-label="Instagram"
          data-tooltip="Instagram"
        >
          <FaInstagram />
        </a>

        <a
          href="https://letterboxd.com/elianamugar"
          target="_blank"
          aria-label="Letterboxd"
          data-tooltip="Letterboxd"
        >
          <SiLetterboxd />
        </a>

        <a
          href="https://goodreads.com/emuggins"
          target="_blank"
          aria-label="Goodreads"
          data-tooltip="Goodreads"
        >
          <FaGoodreadsG />
        </a>

        <a
          href="https://github.com/elianamugar"
          target="_blank"
          aria-label="GitHub"
          data-tooltip="GitHub"
        >
          <FaGithub />
        </a>

        <a
          href="https://youtube.com/@elianamugar"
          target="_blank"
          aria-label="YouTube"
          data-tooltip="YouTube"
        >
          <FaYoutube />
        </a>

        <a
          href="https://imdb.com/name/nm14175264"
          target="_blank"
          aria-label="IMDb"
          data-tooltip="IMDb"
        >
          <FaImdb />
        </a>

        <a
          href="https://linkedin.com/in/elianamugar"
          target="_blank"
          aria-label="LinkedIn"
          data-tooltip="LinkedIn"
        >
          <FaLinkedinIn />
        </a>
      </div>
      </section>

      <section class="media-section">
        <div class="media-column">
          <p class="media-label">What I'm Watching</p>

          <ul class="media-list">
            {mediaFeed.watching.map((item) => (
              <li class="media-item">
                {item.image && (
                  <img
                    src={item.image}
                    alt={`${item.title} cover`}
                    loading="lazy"
                  />
                )}

                <div class="media-meta">
                  <a href={item.link} target="_blank">
                    {item.title}
                  </a>

                  <span class="media-date">
                    {new Date(item.date).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="media-column">
          <p class="media-label">What I'm Reading</p>

          <div class="media-subsection">
            <span class="media-status">Currently reading</span>

            <ul class="media-list">
              {mediaFeed.currentlyReading.map((item) => (
                <li class="media-item">
                  {item.image && (
                    <img
                      src={item.image}
                      alt={`${item.title} cover`}
                      loading="lazy"
                    />
                  )}

                  <a href={item.link} target="_blank">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="media-subsection">
            <span class="media-status">Recently read</span>

            <ul class="media-list">
              {mediaFeed.read.map((item) => (
                <li class="media-item media-read">
                  {item.image && (
                    <img
                      src={item.image}
                      alt={`${item.title} cover`}
                      loading="lazy"
                    />
                  )}

                  <div class="media-meta">
                    <a href={item.link} target="_blank">
                      {item.title}
                    </a>

                    <span class="media-date">
                      Read {new Date(item.date).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </span>

                    {item.rating && (
                      <span class="media-rating">
                        {"★".repeat(item.rating)}{"☆".repeat(5 - item.rating)}
                      </span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>