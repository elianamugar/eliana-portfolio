---

<BaseLayout title="Research & Projects | Eliana Mugar">
  <main class="research-page projects-page">
    <a href="/" class="back-link">← Home</a>

    <section class="research-hero compact-research-hero">
      <p class="research-type-line">
        <span class="prompt">&gt;</span>
        <span id="research-type-text"></span><span class="cursor">_</span>
      </p>
    </section>

    <script>
      const researchTypeElement = document.getElementById("research-type-text");
      const researchText = "research_and_projects";

      let researchIndex = 0;

      function typeResearchLine() {
        if (!researchTypeElement) return;

        if (researchIndex < researchText.length) {
          researchTypeElement.textContent += researchText.charAt(researchIndex);
          researchIndex++;

          setTimeout(typeResearchLine, 65);
        }
      }

      typeResearchLine();
    </script>

    <section class="research-section">
      <p class="section-label">
        <span class="section-prompt">&gt;</span>
        Projects & Systems
      </p>

      <div class="research-grid">
        {featuredProjects.map((project) => (
          <div
            class="research-card clickable-card"
            onclick={`window.open('${project.primaryLink}', '_blank')`}
          >
            <div class="research-card-header">
              <h2>{project.title}</h2>
              <span>{project.status}</span>
            </div>

            <p>{project.description}</p>

            <div class="tag-row">
              {project.links?.length > 0 && (
                <div class="project-links">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="research-section">
      <p class="section-label">
        <span class="section-prompt">&gt;</span>
        Research & Publications
      </p>

      <div class="publication-list">
        {research.map((item) => (
          <article class="publication-item">
            <div>
              <h2>{item.title}</h2>

              <p class="publication-authors"
                set:html={item.authors.replace(
                  "Mugar, E.",
                  "<strong>Mugar, E.</strong>"
                )}
              />

              <p>{item.meta}</p>

              {item.links?.length > 0 && (
                <div class="publication-links">
                  {item.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="research-section">
      <p class="section-label">
        <span class="section-prompt">&gt;</span>
        Research Interests
      </p>

      <div class="interest-cloud">
        {interests.map((interest) => (
          <span>{interest}</span>
        ))}
      </div>
    </section>

    <section class="research-section">
      <p class="section-label">
        <span class="section-prompt">&gt;</span>
        Experimental Projects / Lab Notes
      </p>

      <ul class="lab-list">
        {experiments.map((experiment) => (
          <li>{experiment}</li>
        ))}
      </ul>
    </section>

    <section class="research-section">
      <p class="section-label">
        <span class="section-prompt">&gt;</span>
        Current Explorations
      </p>

      <ul class="lab-list muted-list">
        {currentExplorations.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>