---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { photoProjects } from "../../data/photoProjects";

const R2_BASE_URL = "https://pub-572ebe461d354c81b241244275f0b4f2.r2.dev";

function formatTitle(project) {
  return project
    .split("_")
    .map((word) =>
      word === "ii" || word === "iii"
        ? word.toUpperCase()
        : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");
}

const projects = Object.keys(photoProjects);
---

<BaseLayout title="Photography | Eliana Mugar">
  <main class="section-page">
    <a href="/creative" class="back-link">← Creative Portfolio</a>

    <section class="section-hero">
      <p class="eyebrow">Photography</p>
      <h1>Photography Projects</h1>
      <p class="subtitle">
        Travel, documentary, landscape, and visual essays.
      </p>
    </section>

    <section class="project-grid">
      {projects.map((project) => {
        const cover = `${project}.jpg`;
        const title = formatTitle(project);

        return (
          <a href={`/creative/photography/${project}`} class="project-card">
            <img
                src={`${R2_BASE_URL}/photos/covers/${cover}`}
                alt={`${title} photography cover`}
                loading="lazy"
            />

            <div class="project-card-overlay">
                <p class="eyebrow">{photoProjects[project].length} images</p>
                <h2>{title}</h2>
                <span class="view-project">View project →</span>
            </div>
          </a>
        );
      })}
    </section>
  </main>
</BaseLayout>