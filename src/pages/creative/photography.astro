---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { photoProjects } from "../../data/photoProjects";

const R2_BASE_URL = "https://pub-572ebe461d354c81b241244275f0b4f2.r2.dev";

type PhotoProjects = Record<string, string[]>;

const photoProjectData = photoProjects as PhotoProjects;

import {
  projectDates,
  formatProjectDate,
  formatPhotoTitle,
} from "../../data/photoMetadata";

/*const title = formatPhotoTitle(project);*/

const projects = Object.keys(photoProjectData).sort((a, b) => {
  const dateA = projectDates[a] || "0000-00";
  const dateB = projectDates[b] || "0000-00";

  return dateB.localeCompare(dateA) ||
    formatPhotoTitle(a).localeCompare(formatPhotoTitle(b));
});
---

<BaseLayout title="Photography | Eliana Mugar">
  <main class="section-page">
    <a href="/creative" class="back-link">← Creative Portfolio</a>

    <section class="creative-hero">
      <h1 class="creative-title">
        PHOTOGRAPHY
      </h1>

    </section>

    <section class="project-grid">
      {projects.map((project) => {
        const cover = `${project}.jpg`;
        const title = formatPhotoTitle(project);

        return (
          <a href={`/creative/photography/${project}`} class="project-card">
            <img
              src={`${R2_BASE_URL}/photos/covers/${cover}`}
              alt={`${title} photography cover`}
              loading={project === projects[0] ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={project === projects[0] ? "high" : "auto"}
            />

            <div class="project-card-overlay">
              <h2>{title}</h2>

              {projectDates[project] && (
                <p class="photo-project-year">
                  {formatProjectDate(projectDates[project])}
                </p>
              )}

              <span class="view-project">View project →</span>
            </div>
          </a>
        );
      })}
    </section>
  </main>
</BaseLayout>