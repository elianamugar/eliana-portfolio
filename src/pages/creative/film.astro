const sortedFilms = films.sort(
  (a, b) => Number(b.year) - Number(a.year)
);
---

<BaseLayout title="Film & Video | Eliana Mugar">
  <main class="section-page">
    <a href="/creative" class="back-link">← Creative Portfolio</a>

    <section class="creative-hero">
      <h1 class="creative-title">
        FILM & VIDEO
      </h1>

    </section>

    <section class="film-list">
      {sortedFilms.map((film) => {
        const CardTag = film.url ? "a" : "article";

        return (
          <CardTag
            href={film.url || undefined}
            class="film-card"
            target={film.url ? "_blank" : undefined}
            rel={film.url ? "noreferrer" : undefined}
          >
            <div class="film-meta">
              <span>{film.year}</span>
              <span>{film.type}</span>
            </div>

            <div>
              <h2>{film.title}</h2>
              <p class="film-role">{film.role}</p>
              <p>{film.description}</p>

              {film.url && (
                <span class="film-link">View project →</span>
              )}
            </div>
          </CardTag>
        );
      })}
    </section>
  </main>
</BaseLayout>