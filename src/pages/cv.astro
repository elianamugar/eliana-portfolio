---
import BaseLayout from "../layouts/BaseLayout.astro";

const education = [
  {
    degree: "B.A. Linguistics and Computer Science",
    school: "Boston University",
    details: "Minor in Film & Television",
  },
];

const highlights = [
  "Film editor and visual storyteller",
  "Linguistics + CS background",
  "Digital humanities and authorship attribution research under Patrick Juola",
  "Creative archive / media systems builder",
  "Photographer"
];

const tools = [
  "Adobe Premiere Pro",
  "After Effects",
  "DaVinci Resolve",
  "Photoshop",
  "Lightroom Classic",
  "Illustrator",
  "Audition",
  "Logic Pro X",
  "Python",
  "Java",
  "JavaScript",
  "Excel",
  "GitHub",
  "Praat",
  "NLTK",
  "Astro",
  "Quartz",
];

const roles = [
  "Film Editor",
  "Investigator Analyst",
  "Student Researcher",
  "Social Media Manager",
  "IT Service Desk",
  "Festival Judge",
  "Event Photographer",
  "Research Assistant",
];
---

<BaseLayout title="CV / About | Eliana Mugar">
  <main class="research-page">
    <a href="/" class="back-link">← Home</a>

    <section class="cv-hero">
      <p class="research-type-line">
        <span class="prompt">&gt;</span>
        <span id="cv-type-text"></span><span class="cursor">_</span>
      </p>
    </section>

    <div class="cv-top-grid">

    <section class="research-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        About
      </p>

      <div class="about-block">
        <p>
          Hello! I’m Eliana, a film editor, photographer, linguist, researcher, and occasional programmer interested in how
          images, language, archives, and systems shape the way we understand
          culture. My work moves between creative production, post-production,
          computational linguistics, digital humanities, and personal archive
          building. I'm currently pursuing a commission into the USAF.
        </p>
        <br />
        <p>
          Fun fact: I have 99% more Neanderthal DNA than all 23andMe users.
          <span class="terminal-cursor">_</span>
        </p>
      </div>
    </section>

    <div class="right-column-stack">

    <section class="research-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        Education
      </p>

      <div class="education-block">
        <h2>
          B.A. Linguistics and Computer Science
        </h2>

        <p class="education-school">
          Boston University
        </p>

        <p class="education-details">
          Minor in Film & Television
        </p>
      </div>
      <br />
      <br />
      <br />
      <section class="research-section fun-facts-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        Interests & Hobbies
      </p>

      <p class="interests-inline">
        Traveling; Soccer; Trivia; History; Language learning;
        Reading; Photography; Music; Avid Letterboxd user trying to watch a film per day;
      </p>
    </section>
  </div>
    </section>

    

    </div>

    <section class="cv-dropdown-section" id="cv-dropdown-section">
      <div class="cv-dropdown-row">
        <button class="dropdown-trigger" id="experience-trigger" type="button">
          <span class="dropdown-arrow">&gt;</span>
          Experience
        </button>

        <button class="dropdown-trigger" id="tools-trigger" type="button">
          <span class="dropdown-arrow">&gt;</span>
          Tools
        </button>
      </div>

      <div class="cv-dropdown-content" id="experience-content">
        <div class="timeline">
          {[
            {
              date: "Jan 2020 – Present",
              title: "Film Editor",
              org: "Freelance",
              details: [
                "Edited short films and video projects using Adobe Premiere Pro, After Effects, and DaVinci Resolve.",
                "Worked on multiple award-winning short films.",
              ],
            },
            {
              date: "Nov 2023 – Present",
              title: "Investigator Analyst",
              org: "Quilligence, Inc. | Remote",
              details: [
                "Monitor online accounts and investigate social media platforms to prevent threats and doxxing for high-profile clients.",
                "Completed data entry tasks to update database information.",
              ],
            },
            {
              date: "Aug 2020 – Aug 2023",
              title: "Social Media Manager",
              org: "Women in Technology Non-Profit | Manila, Philippines",
              details: [
                "Partnered with Google Philippines for Digiskarteng Pinay to create tutorial videos on online business creation.",
                "Wrote scripts and assisted with uploads/edits for WiTech YouTube and TikTok.",
              ],
            },
            {
              date: "Aug 2020 – May 2023",
              title: "Information Technology Service Desk",
              org: "IT Help Center | Boston University, MA",
              details: [
                "Supported the university network by troubleshooting technical issues.",
                "Triaged problems by phone and in-person visits.",
                "Facilitated communication between online and in-person students.",
              ],
            },
            {
              date: "Jan 2021 – Aug 2023",
              title: "Student Researcher",
              org: "Evaluating Variations in Language Lab | Duquesne University, PA",
              details: [
                "Supervised by Dr. Patrick Juola.",
                "Researched text-based authorship attribution using Python, Excel, and corpus analysis.",
                "Co-authored research on adjective/adverb analysis for stylometry.",
                "Conducted experimental research with self-made NLTK Python scripts.",
              ],
            },
            {
              date: "Jun 2022 – Oct 2022",
              title: "Research Assistant",
              org: "Phonetics, Acquisition, and Multilingualism Lab | Boston University, MA",
              details: [
                "Supervised by Dr. Charles B. Chang.",
                "Used Excel and Praat to transcribe and annotate phonetic data from recorded audio.",
              ],
            },
            {
              date: "Jun 2018 – Jul 2018",
              title: "Public Information and Communications Department Intern",
              org: "City of Folsom | Folsom, CA",
              details: [
                "Wrote budget reports and informal articles.",
                "Created graphics/logos for city social media and assisted with website revamp.",
                "Delivered a TED Talk based on the internship experience.",
              ],
            },
          ].map((job) => (
            <article class="timeline-item">
              <div>
                <h2>{job.title}</h2>

                <span class="timeline-date">
                  {job.date}
                </span>

                <p class="timeline-org">{job.org}</p>

                {job.details.length > 0 && (
                  <ul class="timeline-details">
                    {job.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="cv-dropdown-content" id="tools-content">
        <div class="tools-layout">

          <div>
            <p class="tools-subheader">Cameras</p>
            <p class="tools-inline">
              Sony FX3, A7III, A7II, A6500 · Canon C100, C200, R6 MkII · RED Komodo · BMPCC 4K · ARRIFLEX 16SR 3
            </p>
          </div>

          <div>
            <p class="tools-subheader">Software</p>
            <p class="tools-inline">
              Premiere Pro · After Effects · Photoshop · Lightroom Classic · Illustrator · Audition · DaVinci Resolve · Final Cut Pro · Logic Pro X · Excel
            </p>
          </div>

          <div>
            <p class="tools-subheader">Research / Code / Web</p>
            <p class="tools-inline">
              Python · Java · JavaScript · HTML/CSS · GitHub · Praat · NLTK · Astro · Quartz
            </p>
          </div>
          
        </div>
      </div>
    </section>

    <script>
      const cvSection = document.getElementById("cv-dropdown-section");

      const experienceTrigger = document.getElementById("experience-trigger");
      const toolsTrigger = document.getElementById("tools-trigger");

      const experienceContent = document.getElementById("experience-content");
      const toolsContent = document.getElementById("tools-content");

      function showCvPanel(panel: "experience" | "tools") {
        const experienceIsOpen = experienceContent?.classList.contains("is-open");
        const toolsIsOpen = toolsContent?.classList.contains("is-open");

        const shouldClose =
          (panel === "experience" && experienceIsOpen) ||
          (panel === "tools" && toolsIsOpen);

        experienceTrigger?.classList.remove("is-active");
        toolsTrigger?.classList.remove("is-active");
        experienceContent?.classList.remove("is-open");
        toolsContent?.classList.remove("is-open");

        if (shouldClose) return;

        const showExperience = panel === "experience";

        experienceTrigger?.classList.toggle("is-active", showExperience);
        toolsTrigger?.classList.toggle("is-active", !showExperience);
        experienceContent?.classList.toggle("is-open", showExperience);
        toolsContent?.classList.toggle("is-open", !showExperience);

        setTimeout(() => {
          cvSection?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }, 50);
      }

      experienceTrigger?.addEventListener("click", () => showCvPanel("experience"));
      toolsTrigger?.addEventListener("click", () => showCvPanel("tools"));
    </script>

    <script>
      const cvTypeElement = document.getElementById("cv-type-text");
      const cvText = "cv_about";

      let cvIndex = 0;

      function typeCvLine() {
        if (!cvTypeElement) return;

        if (cvIndex < cvText.length) {
          cvTypeElement.textContent += cvText.charAt(cvIndex);
          cvIndex++;

          setTimeout(typeCvLine, 65);
        }
      }

      typeCvLine();
    </script>
  </main>
</BaseLayout>