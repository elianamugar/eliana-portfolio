<BaseLayout title="CV / About | Eliana Mugar">
  <main class="research-page">
    <a href="/" class="back-link">← Home</a>

    <section class="cv-hero">
      <p class="research-type-line">
        <span class="prompt">&gt;</span>
        <span id="cv-type-text"></span><span class="cursor">_</span>
      </p>
    </section>

    <div class="cv-top-grid">

    <section class="research-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        About
      </p>

      <div class="about-block">
        <p>
          Hello! I’m Eliana, a film editor, photographer, linguist, researcher, and occasional programmer interested in how
          images, language, archives, and systems shape the way we understand
          culture. My work moves between creative production, post-production,
          computational linguistics, digital humanities, and personal archive
          building. I'm currently pursuing a commission into the USAF.
        </p>
        <br />
        <p>
          Fun fact: I have 99% more Neanderthal DNA than all 23andMe users.
          <span class="terminal-cursor">_</span>
        </p>
      </div>
    </section>

    <div class="right-column-stack">

    <section class="research-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        Education
      </p>

      <div class="education-block">
        <h2>
          B.A. Linguistics and Computer Science
        </h2>

        <p class="education-school">
          Boston University
        </p>

        <p class="education-details">
          Minor in Film & Television
        </p>
      </div>
      <br />
      <br />
      <br />
      <section class="research-section fun-facts-section">
      <p class="section-label left-section-label">
        <span class="section-prompt">&gt;</span>
        Interests & Hobbies
      </p>

      <p class="interests-inline">
        Traveling; Soccer; Trivia; History; Language learning;
        Reading; Photography; Music; Avid Letterboxd user trying to watch a film per day;
      </p>
    </section>
  </div>
    </section>

    

