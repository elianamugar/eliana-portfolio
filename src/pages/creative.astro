---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Creative Portfolio | Eliana Mugar">
  <main class="section-page">
    <a href="/" class="back-link">← Home</a>

    <section class="section-hero">
      <p class="eyebrow">Creative Portfolio</p>
      <h1>Photography, film, and visual archives.</h1>
      <p class="subtitle">
        A collection of image-making, editing, design, travel, and cinematic work.
      </p>
    </section>

    <section class="creative-grid">
      <a href="/creative/photography" class="creative-card photography-card">
        <div>
          <p class="eyebrow">01</p>
          <h2>Photography</h2>
          <p>Travel, documentary, landscape, and visual essays.</p>
        </div>
      </a>

      <a href="/creative/film" class="creative-card film-card">
        <div>
          <p class="eyebrow">02</p>
          <h2>Film & Video</h2>
          <p>Editing, short films, reels, and moving-image work.</p>
        </div>
      </a>

      <a href="/creative/posters" class="creative-card posters-card">
        <div>
          <p class="eyebrow">03</p>
          <h2>Posters & Design</h2>
          <p>Poster work, graphics, visual experiments, and layouts.</p>
        </div>
      </a>
    </section>
  </main>
</BaseLayout>