<BaseLayout title="Creative Portfolio | Eliana Mugar">
  
  <main class="section-page">
    <a href="/" class="back-link">← Home</a>

    <section class="creative-hero">
      <h1 class="creative-title">
        CREATIVE PORTFOLIO
      </h1>

    <section class="creative-grid">
      <a href="/creative/photography" class="creative-card photography-card">
        <div>
          <h2>Photography</h2>
        </div>
      </a>

      <a href="/creative/film" class="creative-card film-card">
        <div>
          <h2>Film & Video</h2>
        </div>
      </a>

      <a href="/creative/posters" class="creative-card posters-card">
        <div>
          <h2>Posters & Design</h2>
        </div>
      </a>
    </section>

    <section class="creative-dropdown-section" id="creative-dropdown-section">
      <div class="creative-dropdown-row">
        <button class="dropdown-trigger" id="credits-trigger" type="button">
          <span class="dropdown-arrow">&gt;</span>
          Credits
        </button>

        <button class="dropdown-trigger" id="achievements-trigger" type="button">
          <span class="dropdown-arrow">&gt;</span>
          Notable Achievements
        </button>
      </div>

      <div class="creative-dropdown-content" id="credits-content">
        <div class="film-list">
          {credits
            .sort((a, b) => {
              const yearA = typeof a.year === "number" ? a.year : 0;
              const yearB = typeof b.year === "number" ? b.year : 0;
              return yearB - yearA;
            })
            .map((credit) => (
              <article class="film-entry">
                <div>
                  <h2>{credit.title}</h2>
                  <p class="credit-year">{credit.year}</p>
                  <p class="credit-director">{credit.meta}</p>
                  <p class="credit-roles">{credit.roles}</p>
                </div>
              </article>
            ))}
        </div>
      </div>

      <div class="creative-dropdown-content" id="achievements-content">
        <div class="achievement-list">
          <div class="achievements-columns">
          {Object.entries(groupedAchievements)
            .sort(([a], [b]) => Number(b) - Number(a))
            .map(([year, items]) => (
              <section class="achievement-year-group">
                <h2 class="achievement-year-heading">
                  {year}
                </h2>

                <div class="achievement-list">
                  {items.map((item) => (
                    <article class="achievement-entry">
                      <h2>{item.title}</h2>

                      <p class="achievement-meta">
                        {item.meta}
                      </p>

                      <ul>
                        {item.achievements.map((achievement) => (
                          <li>{achievement}</li>
                        ))}
                      </ul>
                    </article>
                  ))}
                  </div>
                </div>
              </section>
            ))}

<script>
  const section = document.getElementById("creative-dropdown-section");

  const creditsTrigger = document.getElementById("credits-trigger");
  const achievementsTrigger = document.getElementById("achievements-trigger");

  const creditsContent = document.getElementById("credits-content");
  const achievementsContent = document.getElementById("achievements-content");

  function showPanel(panel: "credits" | "achievements") {
    const creditsIsOpen = creditsContent?.classList.contains("is-open");
    const achievementsIsOpen = achievementsContent?.classList.contains("is-open");

    const shouldClose =
      (panel === "credits" && creditsIsOpen) ||
      (panel === "achievements" && achievementsIsOpen);

    creditsTrigger?.classList.remove("is-active");
    achievementsTrigger?.classList.remove("is-active");
    creditsContent?.classList.remove("is-open");
    achievementsContent?.classList.remove("is-open");

    if (shouldClose) return;

    const showCredits = panel === "credits";

    creditsTrigger?.classList.toggle("is-active", showCredits);
    achievementsTrigger?.classList.toggle("is-active", !showCredits);

    creditsContent?.classList.toggle("is-open", showCredits);
    achievementsContent?.classList.toggle("is-open", !showCredits);

    setTimeout(() => {
      section?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }, 50);
  }

  creditsTrigger?.addEventListener("click", () => showPanel("credits"));
  achievementsTrigger?.addEventListener("click", () => showPanel("achievements"));
</script>

  </main>
</BaseLayout>