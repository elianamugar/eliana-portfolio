const sortedAchievements = [...achievements].sort((a, b) => {
  const yearA = Number(a.meta.match(/\d{4}/)?.[0] || 0);
  const yearB = Number(b.meta.match(/\d{4}/)?.[0] || 0);

  return yearB - yearA;
});

const groupedAchievements: Record<string, Achievement[]> =
  sortedAchievements.reduce(
    (acc: Record<string, Achievement[]>, item: Achievement) => {
      const year = item.meta.match(/\d{4}/)?.[0] || "Unknown";

      if (!acc[year]) {
        acc[year] = [];
      }

      acc[year].push(item);

      return acc;
    },
    {}
  );

